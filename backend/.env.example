# ─── App ──────────────────────────────────────────────
PORT=3010
# Deploy (not read by the app): on Railway set the SERVICE variable
# RAILWAY_DEPLOYMENT_DRAINING_SECONDS=15 (or more). Its default is 0 s between
# SIGTERM and SIGKILL, which skips the graceful shutdown (jobs complete as
# interrupted, open sync runs close) — see the internal design notes.
NODE_ENV=development              # development | production | test
# Reverse-proxy hops in front of the app (Railway/Vercel/nginx = 1). Drives Express
# `trust proxy`, which is what makes req.ip the real client. The anonymous-signup
# throttle is keyed on that IP: leave this at 0 behind a proxy and every visitor
# shares one bucket (a global signup cap); set it higher than the real hop count
# and callers can spoof X-Forwarded-For to mint unlimited buckets.
TRUST_PROXY_HOPS=0

# ─── Storage ──────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/copypools_positions
REDIS_URL=redis://localhost:6379
# Mongo client limits (2026-10-03). The pool was the driver's 100 connections per
# member with an UNBOUNDED wait queue (on 2026-10-01 every API read queued 25–55 s
# behind unindexed scans). A wait past the limit fails with MongoWaitQueueTimeoutError,
# which a user read answers like a maxTimeMS timeout (stale copy flagged, or 503 +
# Retry-After). P2.1: all three are UNSET by default and take the PROCESS_ROLE default
# (common/process-role.ts ROLE_DEFAULTS): pool / wait queue = all 60 / 10 s (today),
# api 12 / 2 s, sync 30 / 30 s, fee 15 / 30 s, feeder 5 / 30 s; appName = tickwise-backend
# in `all`, tickwise-<role> in a split role. Setting one pins it for EVERY role that
# reads this file — leave them unset on split services (an api replica with the `all`
# values holds 60 connections instead of 12). An explicit value always wins.
# MONGO_APP_NAME=                          # unset = tickwise-backend (all) / tickwise-<role>
# MONGO_MAX_POOL_SIZE=                     # unset = role default (all 60); connections per member (clamped 1–500)
# MONGO_WAIT_QUEUE_TIMEOUT_MS=             # unset = role default (all 10000); 0/garbage = the default — no "unbounded" (clamped 100 ms – 5 min)
# Mongoose autoIndex on the SHARD collections (positions, position transactions, pools).
# Unset = OFF in production (indexes come only from scripts/positions-index-migration.mjs;
# a shard collection that does not exist yet still gets its indexes at boot), on elsewhere.
# MONGO_SHARD_AUTO_INDEX=

# ─── Admin auth ───────────────────────────────────────
ADMIN_SECRET=change-me            # required header X-Admin-Secret for /admin/sync/* ops routes
# Admin-panel login (JWT). First admin is seeded on boot from ADMIN_EMAIL/PASSWORD if none exists.
JWT_SECRET=dev-insecure-jwt-secret-change-me   # MUST be a strong random value in production
JWT_EXPIRES_IN=12h
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too
API_KEY_HEADER=KC-APIKey           # header name for the public /v1 API key

# ─── Customer auth (self-serve portal, /account/*) ────
# A SEPARATE realm from the admin JWT above. Prod boot HARD-FAILS unless this is
# set, >=16 chars, and DIFFERENT from JWT_SECRET — reusing the admin secret would
# collapse the two realms while every guard still looks correct, and a customer
# token would then authenticate every /admin route.
CUSTOMER_JWT_SECRET=dev-insecure-customer-jwt-secret-change-me
CUSTOMER_JWT_EXPIRES_IN=12h
# Email verification. Defaults to TRUE. Dev leaves it on whether or not a mailer
# is configured: with one the code is emailed, without one it is written to the
# server log, so the loop is walkable either way. PRODUCTION REFUSES TO BOOT with
# this on while NO MAILER IS CONFIGURED (see the Mail section below) — prod
# deliberately never logs the code, so requiring one nobody can receive locks
# every new signup out. Configure RESEND_API_KEY + MAIL_FROM, or set this false.
# CUSTOMER_EMAIL_VERIFICATION_REQUIRED=false

# ─── Mail (Resend) ────────────────────────────────────
# LEAVE BOTH BLANK to keep the current console-fallback behaviour: in dev the
# verification code is logged (`[dev] Email verification code for …`), and in
# production a loud error names the recipient WITHOUT printing the code. Nothing
# breaks with mail unconfigured — signup, resend and profile edits all still
# succeed; the code just never leaves the machine.
#
# BOTH ARE REQUIRED TOGETHER. A key with no from-address cannot send, so a
# half-filled pair reads as NOT CONFIGURED (console fallback) rather than as a
# provider error on every single email — same rule as the OAuth id/secret pairs.
#
# MAIL_FROM must be a sender RESEND HAS VERIFIED for your account: a verified
# domain (`Tickwise <noreply@yourdomain.com>`), or `onboarding@resend.dev` while
# testing. An unverified sender is accepted here and then 422'd on every send.
RESEND_API_KEY=
MAIL_FROM=
# Optional. Where replies go; blank means they go to MAIL_FROM.
MAIL_REPLY_TO=

# ─── Customer SSO (Google / GitHub / wallet) ──────────
# SSO signs in to the SAME /account/* realm as password login — it mints the
# identical customer token, so nothing about guards, metering or ownership changes.
# A provider is offered ONLY when BOTH its id and secret are set; half-configured
# reads as DISABLED (unset = the button is never advertised) rather than as a
# login that 400s at the token exchange. Leave a pair blank to keep it off.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# THIS backend's public origin. The redirect_uri handed to the provider is built
# from it, so it must EXACTLY match the redirect URI registered in the Google /
# GitHub app console (scheme, host, port, path — no trailing-slash drift) or the
# provider rejects the code exchange with redirect_uri_mismatch.
# 3010 = PORT above, i.e. this process. It read 3000 here, where nothing in this
# repo listens, so an OAuth round trip on the shipped defaults sent the provider a
# redirect_uri pointing at a closed port and the callback never came back.
OAUTH_CALLBACK_BASE_URL=http://localhost:3010
# The frontend origin the browser is redirected back to once the token is minted.
# 3011 = the frontend's `next dev -p 3011`.
PORTAL_BASE_URL=http://localhost:3011
# Prod boot HARD-FAILS if either URL above is http or points at localhost: the
# callback carries a live customer token, so an http hop leaks it in clear and a
# localhost hop hands it to whatever is listening on the victim's own machine.
# The two are gated differently, because they have different readers:
#   OAUTH_CALLBACK_BASE_URL — only when an OAuth provider is configured (nothing
#     else reads it).
#   PORTAL_BASE_URL — when a provider is configured OR wallet login is on. SIWE
#     composes the signed message from it and the password-reset mail builds its
#     link from it, so a wallet-only prod deployment would otherwise ask people to
#     SIGN a message naming http://localhost:3011 and mail dead reset links.
# Wallet (SIWE) login. SIWE_DOMAIN is host[:port], NO scheme (EIP-4361) and must
# match the origin the user signs from — that binding is the ONLY thing stopping a
# signature captured on another site from being replayed here, so prod refuses a
# localhost value while WALLET_LOGIN_ENABLED is true (set the flag false to boot
# without it). SIWE_STATEMENT is the human-readable line inside the signed message.
# Defaults to FALSE in code (opt-in): switching it on makes SIWE_DOMAIN mandatory
# in production, so an on-by-default would hard-fail the boot of every existing
# deployment. Enabled here because localhost is a fine domain binding for dev.
WALLET_LOGIN_ENABLED=true
SIWE_DOMAIN=localhost:3011
SIWE_STATEMENT=Sign in to the Tickwise API portal.

# ─── Payments (self-serve subscriptions) ──────────────
# The rail new checkouts are minted on. Three real values:
#   x402    — THE crypto rail. Self-custody, no middleman, no xpub, no sweep:
#             the customer SIGNS an EIP-3009 authorization and USDC moves itself
#             straight into X402_TREASURY_ADDRESS. Needs a connected self-custody
#             wallet, so it CANNOT take a bare exchange withdrawal.
#   radom   — a hosted redirect rail, kept as the reference shape a FIAT
#             provider will take. Not used for crypto.
#   fake    — the dev rail; refused in production three ways over.
# REMOVED 2026-08-11: `onchain`, the deposit-address rail (xpub → one derived
# address per invoice → watcher → offline sweep). If your env still says
# `onchain`, change it: it is no longer a rail, so every upgrade is refused.
# With the chosen rail's credentials absent the registry logs an alert at boot
# and every upgrade is refused — loud and harmless.
#
# FOR LOCAL WORK without any chain or account, set the next two lines: the fake
# rail settles through the SAME apply path a webhook does, so the whole
# lifecycle — invoice, grant, receipt, the five return states — is walkable.
PAYMENTS_PROVIDER=x402
PAYMENTS_FAKE_ENABLED=false

# ─── Shared chain settings (read by the x402 rail) ─────────────────────
# These are the only things in this backend that talk to a node; RPC use is
# confined to src/payments/providers/x402/.
#
# WHICH TOKENS you accept — LEAVE THIS EMPTY unless you want to accept LESS.
#
# Empty (the default) DERIVES the accept-list as:
#     every token in PAYMENT_TOKEN_REGISTRY  ×  every chain in EVM_RPC_URLS
# so adding an RPC endpoint below is the SINGLE action that starts accepting that
# chain's tokens. Two lists that had to agree is exactly the drift that has an
# operator add an Arbitrum RPC and then wonder why only Base is offered.
#
# The registry (chains.config.ts) is curated FOR THIS RAIL: every entry implements
# EIP-3009. USDT and DAI are deliberately absent — USDT implements it nowhere, and
# DAI has EIP-2612 `permit`, which is a different mechanism. Boot also probes each
# token on chain and refuses one that cannot be signed for, so a mistake is a
# startup alert rather than a customer's failed payment.
#
# Set it explicitly to narrow (one chain for a test), or to add a token the
# registry does not carry:
#   USDC:8453                        — a registry entry, by symbol+chain
#   MYTOK:8453:0xCONTRACT:6          — ANY token, fully specified (address+decimals)
#   MYTOK:8453:0xCONTRACT:18:volatile — …and not a stablecoin (refused until a
#                                        rate-lock path exists)
# A malformed entry throws at boot rather than being skipped.
PAYMENT_ACCEPTED_TOKENS=
#
# Per-chain JSON-RPC endpoints, chainId=url comma-separated. A token whose chain
# has no endpoint here is refused at boot (it would be offered and never settle).
#   1=Ethereum  10=Optimism  137=Polygon  8453=Base  42161=Arbitrum  43114=Avalanche
#
# USE A REAL RPC, NOT A PUBLIC ONE. `https://mainnet.base.org` works for a first
# boot and then rate-limits: this rail reads each token's EIP-712 domain and
# decimals at boot, polls for settlement every 30s, and simulates every payment
# before accepting a signature — a rate-limited endpoint shows up as
# `x402.domain_unverified … over rate limit`, and a token that cannot be verified
# is NOT OFFERED at checkout. Any free Alchemy/QuickNode/Infura key is enough.
EVM_RPC_URLS=
#
# Confirmations before a transfer settles — a REORG budget, chainId=n. A plan
# granted on a transfer a reorg then erases is unrecoverable, so cheap-to-reorg
# chains want more. Falls back to PAYMENT_MIN_CONFIRMATIONS_DEFAULT.
PAYMENT_MIN_CONFIRMATIONS=1=12,8453=30,42161=30,10=30,137=128,43114=5
PAYMENT_MIN_CONFIRMATIONS_DEFAULT=30
PAYMENT_WATCH_INTERVAL_MS=30000
PAYMENT_WATCH_BLOCK_RANGE=2000
#
# How far SHORT a payment may fall and still settle, in MINOR units (cents).
# Default 100 ($1): crypto senders round, and a network fee taken at source
# arrives a few cents light.
#
# TURN THIS DOWN FOR A SMALL-VALUE LIVE TEST. A flat $1 is HALF the price of a
# $2 plan and the WHOLE of a $1 one — at those amounts a payment of one cent
# settles the invoice, so the test goes green without proving anything about
# amounts. Set it to 5 and a $2 live payment becomes a real assertion. Boot
# logs an alert whenever this is not 100, because a tolerance left at test
# settings is money given away on every payment.
PAYMENTS_UNDERPAY_TOLERANCE_MINOR=100

# ─── x402 / EIP-3009 crypto rail (PAYMENTS_PROVIDER=x402) ──────────────
# THE crypto rail, and the one with NO key management at all: the customer SIGNS
# an EIP-3009 authorization and USDC itself moves the money STRAIGHT INTO THE
# TREASURY BELOW. No xpub, no seed, no sweep, nothing to consolidate.
#
# THE TRADE, stated plainly: paying requires a connected self-custody wallet, so
# a customer CANNOT pay from a bare exchange withdrawal (a Coinbase/Binance "send"
# carries no signature and no memo, so with one shared treasury there is nothing
# to attribute it to). Serving exchange payers means a second rail, not a tweak.
#
# THE ONLY SETTING IS AN ADDRESS, and no private key is ever needed here: this is
# where money is paid INTO. The treasury's key stays wherever you keep it (cold
# wallet, hardware, multisig) and never touches this server. Prod refuses to boot
# if what you paste looks like a private key or a mnemonic.
#
# PASTE IT CHECKSUMMED, straight from your wallet. A mixed-case value is verified
# against its EIP-55 checksum and REFUSED if it fails: `…d359` mistyped as `…d352`
# is a perfectly valid address that nobody holds the key to, and a hex-shape check
# alone accepts it while lowercasing destroys the only evidence of the mistake.
# An all-lowercase value is accepted as-is (such a string carries no checksum).
# DELIBERATELY BLANK, and do not paste a working address here. An example file that
# ships a real treasury sends every deployment that forgets to override it — and
# every fork — to whoever owns that address. Boot refuses an empty value, so the
# mistake is loud instead of silent.
X402_TREASURY_ADDRESS=
# TWO DIFFERENT CLOCKS. Conflating them once made every renewal on this rail
# unpayable, so they are separate settings with separate meanings:
#   ..._AUTHORIZATION_TTL_MS — the SIGNATURE's window (the signed `validBefore`),
#     stamped when a specific wallet is handed a payload to sign. Short on purpose:
#     the token enforces it, so an abandoned signature becomes unspendable on its
#     own with nothing to revoke. Minimum 60s; default 30 min.
#   ..._QUOTE_TTL_MS — how long the QUOTE stays fresh. DAYS, not minutes, because a
#     renewal quote is minted SUBSCRIPTION_RENEWAL_LEAD_DAYS (7) before its period
#     even starts. Past it, the next checkout RE-QUOTES (fresh nonce, current
#     amount) instead of showing a stale one. Minimum 1h; default 30 days.
X402_AUTHORIZATION_TTL_MS=1800000
X402_QUOTE_TTL_MS=2592000000
#
# THE RELAYER — OPTIONAL, AND THE RECOMMENDED SETTING IS BLANK.
#
# LEAVE IT EMPTY and this server holds NO PRIVATE KEY OF ANY KIND. The customer's
# wallet submits its own authorization and pays its own gas (one extra
# confirmation in the wallet, fractions of a cent on Base). That is the strongest
# posture available and it is a fully supported path, not a degraded one — boot
# logs `No X402_SUBMITTER_PRIVATE_KEY — customers will submit their own
# authorizations`, and the calldata is still built server-side so there is only
# ever one encoder.
#
# SET IT ONLY IF you want to pay gas on customers' behalf (one wallet
# confirmation instead of two). It is then a GAS-ONLY throwaway account: every
# money field (`from`, `to`, `value`, `nonce`) is inside the CUSTOMER's signature,
# so altering any of them makes the token reject the call. **Blast radius of a
# full server compromise: the ETH float in this one account** — fund it with a few
# dollars per chain and treat it as disposable.
#
# NEVER the treasury's key — boot REFUSES the two being equal. The treasury only
# ever receives; sharing the key is the single change that turns a gas-float leak
# into "everything we have ever collected".
X402_SUBMITTER_PRIVATE_KEY=
#
# Tokens and chains come from PAYMENT_ACCEPTED_TOKENS / EVM_RPC_URLS above — ONE
# accept-list for every crypto rail. One extra constraint applies here: the token
# must implement EIP-3009. USDC and Circle's other FiatTokens do; **USDT DOES
# NOT**, and a BRIDGED token (USDC.e) often has a different EIP-712 domain. Each
# accepted token's domain is verified against the chain's own DOMAIN_SEPARATOR()
# at boot, and one that fails is NOT OFFERED — so a wrong entry is a boot alert
# instead of a customer signing something the token will reject.

# Radom — hosted USDC checkout. BOTH the API key and the webhook secret are
# required for the rail to count as configured: a key with no webhook secret can
# TAKE money and then cannot be told that it did.
RADOM_API_KEY=
RADOM_API_BASE_URL=https://api.radom.com          # swap for the sandbox host
# The static key Radom sends in `radom-verification-key`. It is the ONLY thing
# authenticating POST /webhooks/payments/radom — an unauthenticated write path
# into the money code — so prod requires >=16 chars.
RADOM_WEBHOOK_SECRET=
# Accepted alongside the current key so a rotation has no rejection window.
# UNSET IT once the rotation is done: every delivery accepted on it logs an
# alert, and prod refuses to boot if it equals the current secret.
RADOM_WEBHOOK_SECRET_PREVIOUS=
RADOM_ACCEPTED_METHODS=USDC:Ethereum,USDC:Base,USDC:Arbitrum
RADOM_CHECKOUT_TTL_MS=3600000                     # our copy of the pay link's deadline; 0 = no expiry

# Days of continued access after a period ends unpaid. SNAPSHOTTED onto each
# subscription at create time, so changing this never moves a deadline a
# customer already signed up under.
SUBSCRIPTION_GRACE_DAYS=7
# How early the renewal invoice is raised. The rail does NOT auto-renew, so this
# is the customer's entire window to pay — it has to cover ARRANGING a crypto
# transfer, not merely confirming one.
SUBSCRIPTION_RENEWAL_LEAD_DAYS=7
# The lifecycle clock. OFF means nothing renews, nothing lapses and nothing is
# ever cut off — valid during a migration, a disaster left on.
SUBSCRIPTION_SWEEP_ENABLED=true
SUBSCRIPTION_SWEEP_INTERVAL_MS=3600000            # 1h
# The lost-webhook backstop. Far more often than the sweep, because the window
# it covers is "a customer has paid and does not have their plan".
PAYMENT_RECONCILE_INTERVAL_MS=900000              # 15m

# ─── External data sources ────────────────────────────
# ONE indexer url per chain. It feeds EVERYTHING: positions, position
# transactions, pool TVL/volume/fees, charts, the interval snapshots and the
# `derivedETH` behind subgraph-sourced pricing. It also GATES the chain — unset
# means that integration is disabled at boot.
#
# It is the Envio indexer, NOT a The Graph deployment. The Graph's hosted service
# was removed in the Envio cutover: there is no GRAPH_API_KEY and no gateway URL
# rewriting left, so a `gateway.thegraph.com` url would go out keyless. The boot
# check refuses one outright rather than letting it half-work.
# ─── THE ONE YOU NORMALLY SET ─────────────────────────
# Every v4 chain is served by the SAME multichain Envio deployment, so set the
# url ONCE here and leave the per-chain keys below unset. Four copies of one url
# is pure drift surface, and it drifted: three chains were left on
# `gateway.thegraph.com` (which the boot check REFUSES) while another pointed at
# a deployment answering HTTP 404 — and nothing surfaced either.
#
# There is no chain list. The `row(...)` calls in `integrations.config.ts` already
# enumerate the chains; to stage one dark, comment its row out (the v3 row shows
# the convention). Per-chain keys below still override this for a chain sitting on
# its own deployment while it backfills.
UNISWAP_V4_INDEXER_URL=
UNISWAP_V4_INDEXER_DIALECT=            # thegraph | hyperindex — see the dialect note below

# ─── PER-CHAIN OVERRIDES (normally all unset) ─────────
# Set one of these ONLY to point a single chain somewhere else. An unset key with
# UNISWAP_V4_INDEXER_URL set is the normal case, not a disabled chain.
ETHEREUM_UNISWAP_V4_SUBGRAPH_URL=                    # Envio indexer for chain 1; gates the Ethereum v4 integration (unset = off)
AVALANCHE_UNISWAP_V4_SUBGRAPH_URL=                   # Envio indexer for Avalanche C-Chain (43114); gates that integration. NOTE: bundle.ethPriceUSD/derivedETH are AVAX-denominated (native gas token is AVAX, not ETH) — the derivedETH × ethPriceUSD product is still USD.
ARBITRUM_UNISWAP_V4_SUBGRAPH_URL=                    # Envio indexer for Arbitrum One (42161); gates that integration. MUST actually cover 42161: a deployment that does not answers 200 with an EMPTY array rather than an error, so every Arbitrum chart silently renders "no data" and the 42161 pool shard fills with another chain's pools. Cheap check: token(id:"0x0000000000000000000000000000000000000000").symbol must be ETH (Avalanche's returns AVAX) and bundle.ethPriceUSD must be the ETH price.
ROBINHOOD_UNISWAP_V4_SUBGRAPH_URL=       # Envio indexer for chainId 4663; gates the Robinhood integration (unset = off). LIVE as of 2026-09-18 — the current deployment DOES cover 4663 (an earlier one did not, and the note here said so for longer than it was true; probe `chain_metadata` rather than trusting either claim). Expect `degraded` on /health while its backfill catches up: it was ~25% through the chain when switched on, and `blockTimeMs: 100` gives 4663 a tight time-scaled lag budget.
ETHEREUM_UNISWAP_V3_SUBGRAPH_URL=                    # required for v3 sync (currently dormant)
# *_SUBGRAPH_DIALECT — which dialect the Envio url speaks. Ponder always uses
# `thegraph` on its `/subgraph` route. The name refers to the GraphQL DIALECT,
# not to The Graph's hosted service, which this backend no longer uses.
#   thegraph    (default) the endpoint already answers The Graph's query dialect
#               natively — Envio's graph-api mode and Ponder's /subgraph route
#               both answer it, so queries go out untouched.
#   hyperindex  a RAW Envio HyperIndex/Hasura endpoint (indexer.hyperindex.xyz),
#               which this backend converts.
# Never guessed from the hostname: Envio's two modes look alike, and a wrong
# guess returns a well-formed EMPTY list rather than an error.
#
# One multichain HyperIndex deployment can serve several chains from ONE url —
# ids there are `<chainId>_`-prefixed and every root query is chain-scoped by the
# converter, so the same url is safe in several chains' rows. Check which chains a
# deployment actually covers with `{ chain_metadata { chain_id } }` before wiring it:
# a chain the indexer does not cover answers 200 with an EMPTY array, not an error.
ETHEREUM_UNISWAP_V4_SUBGRAPH_DIALECT=
AVALANCHE_UNISWAP_V4_SUBGRAPH_DIALECT=
ARBITRUM_UNISWAP_V4_SUBGRAPH_DIALECT=
ROBINHOOD_UNISWAP_V4_SUBGRAPH_DIALECT=

# ─── Ponder, and Envio ⇄ Ponder failover ──────────────
# The Ponder indexer serves the SAME data through its `/subgraph` route, so the
# backend can read Envio, Ponder, or both with automatic failover. Ponder runs one
# process per chain, so its url is per chain only — and it must be the /subgraph
# route (the root /graphql speaks Ponder's own dialect and fails every query).
ETHEREUM_UNISWAP_V4_PONDER_URL=                      # e.g. http://ponder-mainnet:42069/subgraph
AVALANCHE_UNISWAP_V4_PONDER_URL=
ARBITRUM_UNISWAP_V4_PONDER_URL=
ROBINHOOD_UNISWAP_V4_PONDER_URL=
# Which indexers serve, in priority order (first = primary, the rest = fallbacks):
#   envio          Envio only          ponder          Ponder only
#   envio,ponder   Envio, Ponder when Envio is down or too far behind
#   ponder,envio   Ponder, Envio when Ponder is down or too far behind
# Fleet-wide below, overridable per chain. A listed source a chain has no url for
# is skipped. Unset = every configured source, Envio first.
UNISWAP_V4_INDEXER_SOURCES=
ETHEREUM_UNISWAP_V4_INDEXER_SOURCES=
AVALANCHE_UNISWAP_V4_INDEXER_SOURCES=
ARBITRUM_UNISWAP_V4_INDEXER_SOURCES=
ROBINHOOD_UNISWAP_V4_INDEXER_SOURCES=
# Failover tuning (only matters when a chain has two sources). A source that
# errors (network, 429, 5xx, 4xx, or GraphQL errors) is skipped for the cooldown,
# doubling per consecutive failure up to 5 min. A probe reads each source's
# indexed block every PROBE_MS; one more than MAX_LAG_SECONDS of blocks behind the
# freshest is used only if nothing fresher answers. While a fallback is serving,
# the refresh's stale sweep stands down (a lagging fallback must not close live
# positions). /health shows the serving source per chain under `indexer`.
INDEXER_FAILOVER_COOLDOWN_MS=15000
INDEXER_FAILOVER_PROBE_MS=30000                      # 0 disables the probe
INDEXER_FAILOVER_MAX_LAG_SECONDS=300
COINGECKO_API_KEY=                                   # optional; raises rate limits

# ─── Indexer request retry ────────────────────────────
# Caps `requestWithRetry`, which every indexer request goes through. It retries
# 5xx, 429, network errors, and the transient failures that arrive as HTTP 200
# with a GraphQL errors[] body (the classifier every status check misses).
INDEXER_RETRY_ATTEMPTS=4
INDEXER_RETRY_BASE_MS=500

# ─── Indexing-status badge on /health (synced vs current block) ──
# The "current" (chain-head) block comes from DeFiLlama's keyless
# block-by-timestamp endpoint (coins.llama.fi) — no RPC, no key, no extra URL.
# INDEXER_MAX_LAG_BLOCKS = healthy→degraded lag threshold (blocks).
INDEXER_MAX_LAG_BLOCKS=250

# ─── Positions sync (subgraph → mongo) ────────────────
# The refresh tick is the single scheduled-work primitive: it drives position
# re-fetch, transaction sync (open + closed), reprice/heal, and the stale sweep.
POSITIONS_SYNC_CRON_ENABLED=true
POSITIONS_SYNC_INTERVAL_MS=1800000       # 30 min (re-fetches every active position; changes arrive via the live listener). Rides the `positions-refresh` queue, ONE chain at a time, each on its own minute steered around the sweeps' start minutes (default map :04/:34, :09/:39, :19/:49, :24/:54)
# Obliterate positions-sync, positions-refresh and background-sweeps (every job
# AND every cron) at boot. DEFAULT FALSE since 2026-10-03 — production must run
# with it false (unset): wiping the queue is what lost an in-flight backfill on
# every deploy. Stale crons are removed by name, boot kicks are de-duplicated,
# and an interrupted backfill is re-enqueued from its cursor at boot either way.
# 'true' is a manual reset of a queue in a bad state, for one boot.
# QUEUE_CLEAR_ON_BOOT=false
# POSITIONS_REFRESH_CONCURRENCY=2         # refresh chunks in flight (was 32 — only produced indexer bursts)
# POOLS_SYNC_INTERVAL_MS=21600000         # 6 h; a scheduled run within 3 h of a complete walk is skipped, and unchanged pools are not rewritten
# TOKEN_SECURITY_SCOPE=active             # GoPlus checks active-position tokens only (no indexer walk); 'universe' pages every indexer token

# ---- On-chain uncollected-fee refresh (PositionFeeRefreshService) ----
# StateView read of every active position's uncollected fees on a 60 s
# in-process tick (detail-view re-reads, then changed / newly backfilled
# positions, then a full pass every 45 min), batched through Multicall3.
# Replaces the indexer's sweep, which never commits on the largest chains and
# writes 0 for out-of-range positions. A chain is skipped (with an
# [alert] fees.no_rpc at boot) until it has a URL in EVM_RPC_URLS (the same
# list the payments rail uses — adding a chain that has a token in
# PAYMENT_TOKEN_REGISTRY, e.g. 43114 USDC, also turns its payments on unless
# PAYMENT_ACCEPTED_TOKENS pins the accept-list). Use an ARCHIVE endpoint —
# every read is pinned to one block. Never unbatch (that is ~648M requests/month).
POSITION_FEE_REFRESH_ENABLED=true
POSITION_FEE_REFRESH_INTERVAL_MS=3600000   # 1h — only the BullMQ backstop that pokes the 60 s tick
POSITION_FEE_BATCH_SIZE=200                # positions per Multicall3 request (~29k gas each: 200 ≈ 5.8M)
POSITION_FEE_CONCURRENCY=8                 # concurrent requests per chain (Dwellir limit is account-wide)
POSITION_FEE_HOT_MIN_USD=50                # hot tier: in-range positions worth at least this
POSITION_FEE_HOT_INTERVAL_MS=0             # hot tier OFF (0); a positive value is one hot pass per this (min 60 s)
POSITION_FEE_FULL_INTERVAL_MS=2700000      # full tier: every active position every 45 min (start to start)
POSITION_FEE_MAX_PER_TICK=25000            # positions READ per 60 s round across ALL chains — a ceiling (was 15000 until 2026-10-03). The write gate below is unchanged, so a pass writing many rows stays write-bound (10% written ≈ 42 writes/s at 25000)
POSITION_FEE_RAMP_MS=300000                # reads AND the write gate ramp from 25% to 100% over this after boot (was a 30-min constant; 0 = no ramp)
POSITION_FEE_RESTAMP_MS=86400000           # identical, still-valid re-reads are not rewritten until this old, ±25% per position (0 = ALWAYS WRITE — a trap)
POSITION_FEE_MAX_WRITES_PER_SEC=40         # process-wide fee writes per second, all chains (chunks of ≤100 wait for tokens; backfill lane ≤ half). Caps pass speed: keep ≥ MAX_PER_TICK × (share of rows written) / 60
POSITION_FEE_MAX_SERVED_WRITES_PER_SEC=25  # of those, writes that also rewrite the served (indexed) fields; keep ≥ MAX_PER_TICK × (share served) / 60
POSITION_FEE_PASS_ALERT_MS=3000000         # [alert] fees.pass_overdue once per pass still running after 50 min
POSITION_FEE_VIEW_PER_TICK=200             # detail-view re-reads per chain per tick (5-min cooldown per position; 0 = off)
# ── P3.2 / P3.3: fee pass ≤ 10 min (src/sync/fee-measurer.ts) — every default = today ──
# Rollout (design §12, the internal design notes): POSITION_FEE_CANDIDATES=memory first (at 45 min), then
# the dry runs per chain (feeStatus().chains[].latencyP95Ms / suggestedSlots), then BATCH_SIZE=500
# with 1:400, CONCURRENCY 12–16 with the measured BY_CHAIN slots (4663:32+), HEAD_PER=page,
# BUDGET=per-chain, RPC_BUDGET_PER_SEC, and only then POSITION_FEE_FULL_INTERVAL_MS=600000 +
# PASS_ALERT_MS=720000 + MAX_WRITES 200 / SERVED 50 (with WRITE_BUDGET_MODE=enforce).
POSITION_FEE_BATCH_SIZE_BY_CHAIN=          # chain:size,… (each 1–500) overriding POSITION_FEE_BATCH_SIZE, e.g. 1:400
POSITION_FEE_CONCURRENCY_BY_CHAIN=         # chain:slots,… (each 1–64) overriding POSITION_FEE_CONCURRENCY, e.g. 4663:32 (from the measured L(500))
POSITION_FEE_MAX_IN_FLIGHT=64              # multicalls in flight per process, every chain and both lanes (fee + P3.1 backfill)
POSITION_FEE_HEAD_PER=batch                # batch (today: one eth_blockNumber per batch) | page (one head per page, every batch pinned to it)
POSITION_FEE_BUDGET=round                  # round (today: one 60 s read budget shared by every chain) | per-chain (each chain sized to finish its pass in PASS_TARGET_MS)
POSITION_FEE_PASS_TARGET_MS=480000         # per-chain budget: the pass length each chain is sized for (8 min of a 10-min interval)
POSITION_FEE_CANDIDATES=mongo              # mongo (today: each page read from the primary) | memory (RAM store: unchanged rows cost no Mongo read or write)
POSITION_FEE_LOAD_DOCS_PER_SEC=5000        # memory: the boot load's pace on a secondary (max 8000); the load IS the first pass
POSITION_FEE_RECONCILE_MS=21600000         # memory: re-read the actives from the secondary this often (6 h), and on a hint gap
POSITION_FEE_RECONCILE_DOCS_PER_SEC=3000   # memory: reconcile pace (max 5000)
FEE_SIGNALS_TRANSPORT=auto                 # auto (redis exactly when leases are on) | memory | redis — markViewed / markDirty queues (redis-state with leases on, every role)
# Parallel time-bucket walkers on a `fromStart` backfill. KEEP THIS AT 1 on the
# hosted Envio endpoint: it rate-limits (HTTP 429 "indexer is rate limiting"),
# each walker ALSO pulls pools, tokens and pool stats, and the per-bucket
# try/catch swallows every 429 — so the run still reports `status: success`
# having written a fraction of the chain (measured 2.2% of mainnet, 13.1% of
# Arbitrum at 20 buckets). A serial walk did the full 403k mainnet corpus in
# ~11 minutes with no 429 at all, so the parallelism bought nothing. A bucketed
# run also cannot RESUME (it persists no cursor until the end): its retry, or
# the boot's resume, walks serially from 0. A serial walk resumes from its last
# flush (a fromStart reset happens once per BullMQ job).
POSITIONS_BACKFILL_BUCKETS=1

# ─── Transactions sync (rides the position refresh tick — no standalone cron) ─
TRANSACTIONS_SYNC_ENABLED=true           # master switch
TRANSACTIONS_SYNC_BATCH_SIZE=1000        # reprice budget: positions per tick the source='none' reprice scan processes
TRANSACTIONS_HISTORICAL_PRICING_ENABLED=true

# ─── Live event listener (indexer change feed on updatedAtBlock) ─
# Set false during a large indexer backfill: while the indexer is still catching up it
# bumps updatedAtBlock across the index, so the listener firehoses (pages=20 cap)
# and re-prices the same positions every few seconds. Re-enable after /ready=200.
LIVE_REFRESH_ENABLED=true
LIVE_POLL_INTERVAL_FALLBACK_MS=3000      # used only when a chain has no blockTimeMs
LIVE_POLL_MIN_MS=3000                    # floor across all chains (100 ms chains would otherwise poll 120×/min)
LIVE_REFRESH_CONCURRENCY=100             # BullMQ worker concurrency (must be >= batch size)
LIVE_REFRESH_BATCH_SIZE=100              # coalesce up to N per-token jobs into one batched indexer call
LIVE_REFRESH_FLUSH_MS=2000               # max time to hold a partial batch before flushing

# ─── Pricing ──────────────────────────────────────────
# Provider walk order (csv). VALUATION trusts only external aggregators
# (defillama/coingecko + alchemy/moralis/chainbase) + stable/native anchors — Revert
# parity: a token with no trusted external feed is valued at $0, so spam pools don't
# show fabricated underlying. 'subgraph-current' (on-chain derivedETH × ethPriceUSD) is
# intentionally NOT a token-USD source — it mislabels pool-derived prices as external,
# inflating spam positions; charts still read the indexer directly.
# 'subgraph-pool-ratio' must stay last (needs anchor prices from earlier providers).
PRICING_PROVIDERS=subgraph-historical,defillama,coingecko,alchemy,moralis,chainbase,subgraph-pool-ratio
PRICE_FALLBACK_ENABLED=true              # DefiLlama for spot pricing
PRICING_PROVIDER_MAX_CONCURRENCY=8       # provider-internal HTTP concurrency (Defillama et al)
PRICING_HISTORICAL_SINGLE_CONCURRENCY=8  # per-token historical fan-out when provider lacks batch
PRICING_PREFETCH_CHUNK_CONCURRENCY=4     # parallel batch chunks during current-price prefetch
PRICING_POOL_RATIO_BATCH_SIZE=50         # max requests grouped per pool-snapshot fetch
PRICING_POOL_RATIO_CONCURRENCY=10        # parallel pool-snapshot fetches per batch call
PRICING_POOL_RATIO_MAX_LAG_SECONDS=86400 # snapshot must be within this many seconds of the txn timestamp

# ─── Valuation fixes (docs/spam-and-pool-mismatch-2026-10-05.md) — every default = today ──
# Dry run FIRST: `npx tsx scripts/valuation-impact-report.mjs` (read-only; the internal design notes has the rollout order).
# Fix 1 — quote guard: reject provider quotes the provider DATED older than PRICE_QUOTE_MAX_AGE_MS (DIA `Time`,
# DeFiLlama `timestamp`) and DIA quotes with < PRICE_DIA_MIN_VOLUME_USD of 24h volume, in the hot walk, the page walk
# and the consensus sweep; a saved price backed only by rejected quotes is cleared; listed/listed pairs whose leg is
# single-source are cross-checked against the pool (ratio + backing floor). off = today.
PRICE_QUOTE_GUARD=off
# PRICE_QUOTE_MAX_AGE_MS=86400000          # 24 h; also earned trust's freshness check and its verdict lifetime
# PRICE_DIA_MIN_VOLUME_USD=1000            # 0 disables the DIA volume check
# Fix 4 — token trust: allowlist = anchor || committed CoinGecko allowlist (today); earned = anchor || a fresh verdict
# the consensus sweep earns from market evidence (>= 2 agreeing fresh sources incl. a non-DEX aggregator, an active DEX
# market, more than one real pool). No list to maintain. SHADOW=on stores verdicts WITHOUT using them (for the report).
# combined = anchor || allowlisted (its pools get the pools sync's 10% pool-price cross-check) || earned — keeps listed
# tokens a DEX market cannot vouch for (4663 stock tokens are single-source) and adds real unlisted ones (BTC.b).
TOKEN_TRUST_MODE=allowlist
TOKEN_TRUST_SHADOW=off
# Emergency DENY (never anchors), comma separated: `chainId:0x…` or bare `0x…` (every chain). Works in every mode.
# A `trustDenied: true` set by hand on the {chainId}_tokens doc works in TOKEN_TRUST_MODE=earned / combined only.
TOKEN_TRUST_DENY=
# TOKEN_TRUST_MIN_POOLS=2                   # earned (c): DEX pools that each pass the per-pool floor below
# TOKEN_TRUST_MIN_POOL_LIQUIDITY_USD=10000  # earned (c): a pool counts only with this much counter-side USD AND a counter side >= 25% of the pool
# TOKEN_TRUST_MIN_OUTSIDE_LIQUIDITY_USD=50000  # earned (c): or this much counter-side USD outside the deepest pool (0 disables)
# TOKEN_TRUST_DEEP_POOL_LIQUIDITY_USD=250000   # earned (c) single-pool exception (BTC.b-class: one deep balanced pool + a non-DEX source agreeing); 0 = strict
# Fix 2 — hide positions in pools with a static LP fee >= 5% (50,000 pips; v4 dynamic-fee pools and a missing fee exempt)
# from ranked / pool position lists and counts; id and owner lookups still return them. Reads the stored position
# `fee`: no re-sync, no index. Switching it ON (a restart) adds the read models' `fee` rank leaf, which triggers a
# one-time field-backfill rescan of every positions shard (`[alert] read_models.field_backfill`) — do it off-peak.
HONEYPOT_FEE_FILTER=off
# Fix 2 exemption — a pool whose BOTH legs are config anchors (stables / native / wrapped native / trusted majors) is
# never treated as a honeypot-fee pool: not risky in the pools sync (whose fee rule applies whatever the filter says),
# not dropped by HONEYPOT_FEE_FILTER. Real examples: 42161 ETH/USDC at 6.094%, 1 ETH/USDT at 21.079%. off = today.
HONEYPOT_FEE_ANCHOR_EXEMPT=off
# DexScreener current-quote batch endpoint. latest = today's /latest/dex/tokens/{addrs}, which caps the WHOLE request
# at 30 pairs (a popular token takes them all; live: 30 Avalanche tokens -> 5 covered). per-chain = /tokens/v1/{chain}/
# {addrs}: one pair per token (DexScreener's own pick, not always the deepest), every token covered (same probe: 30 of
# 30). Changes which tokens get a DEX price and the active-market verdict (`dexActive`), so check the impact report
# before and after.
DEXSCREENER_BATCH_ENDPOINT=latest
# Chains whose Uniswap v4 pools DexScreener does NOT index (probed 2026-10-08: Arbitrum 0 of 32 pool ids). A token
# DexScreener has no pair for there is not known to lack a market, so its healthy-but-empty answer is neither
# "covered" nor a trust verdict: it can no longer turn a GeckoTerminal miss into dexActive:false (the
# no-real-market exclusion that hid clean Arbitrum tokens after dexscreener joined PRICING_PROVIDERS), and no
# token-pairs lookup is sent for it. Comma-separated chain ids; `none` = trust DexScreener everywhere (the behaviour
# before this knob). Default 42161.
DEXSCREENER_BLIND_CHAINS=42161
# Fix 3 — tickmath: OPEN positions' amounts from liquidity + range + the pool's current price instead of the indexer's
# amounts as of the last liquidity change. The refresh corrects active rows over one cycle; position writes rise
# (amounts now move with price, so the write-skip hashes change more often). Closed rows unchanged.
POSITION_AMOUNTS_SOURCE=indexer

# ─── Test mode (caps sync paths to newest N positions) ─
TEST_MODE=false
TEST_MODE_POSITION_LIMIT=20000

# ─── Read path, caches and indexer budget (2026-10-01) ────────
# Leaderboard / pools read caches and counts (see the internal design notes).
LEADERBOARD_COUNT_CAP=25000                # counts stop here, flagged totalCapped
LEADERBOARD_CACHE_MAX_MB=64                # in-process per-shard list window cache
LEADERBOARD_WARMUP_ENABLED=true            # warmup of the dashboard landing views (10 s tick, below)
# LEADERBOARD_SNAPSHOT_REDIS_ENABLED=      # unset = on in production only (gzip snapshots, EX = the staleness budget, 45 s)
CHART_CACHE_MAX_MB=64                      # chart-input cache (tx, day data, ticks, pool state)
# Staleness budget (2026-10-03, the accepted trade-off: lists cached 15 s, data <= ~45 s old).
# No unflagged answer's DATA is older than READ_STALENESS_BUDGET_MS — cache age PLUS the
# replication lag of the secondary it was read from (the driver's heartbeats). Older data is
# served only with `stale: true` + `dataAsOf`: a DB timeout fallback, a secondary lagging past
# the budget, a deep page from an aged ladder rung. It also caps the two windows below
# (stale <= budget / 1.1 — the list caches jitter TTLs by ±10 %), the snapshot EX and how long
# a deep-page ladder rung is TRUSTED (served unflagged). Chart day data / ticks / pool state
# follow the same fresh/stale windows (were 10/30 min and 60 s/3 min).
READ_STALENESS_BUDGET_MS=45000
LEADERBOARD_LIST_FRESH_MS=15000            # positions + pools windows, list counts, pool detail, holder counts (not chart inputs: they keep their own TTLs)
LEADERBOARD_LIST_STALE_MS=30000            # …served stale (one background refresh) until this age
LEADERBOARD_WARMUP_INTERVAL_MS=10000       # warmup tick (was a fixed 60 s)
# LEADERBOARD_WARMUP_MIN_AGE_MS=           # re-read a landing window once it is this old; unset = the fresh age (15 s) —
                                           # never re-read a still-fresh window (10 s did, twice the secondary work)
# ONE global Mongo read budget for non-page reads (counts, deep-page walks, window rescues,
# pool holder counts), across ALL processes (a Redis token bucket; per process when Redis is
# off). A read costs the LARGER of the rows it reads (reserved before it runs; it waits up to
# its own deadline — past it a list answers 503 + Retry-After, a count `pending`) and its
# database time at this many rows per second of server time (charged after, as debt): at the
# defaults these reads use at most ~1 s of secondary time per second, whatever their filter's
# selectivity. 0 = off (and no background deep walks).
READ_BUDGET_DOCS_PER_SEC=20000
READ_BUDGET_BURST_DOCS=20000               # bucket depth (at least one second of rate)
LEADERBOARD_DEEP_WALK_CONCURRENCY=2        # request-path deep-page walks of > 1,000 rows at once, per process
# How long a deep-page ladder rung is KEPT (clamped: the budget – 1 h). A rung older than the
# staleness budget is not trusted, but still starts a page no trusted rung can reach within one
# request — that page is served `stale: true` + `dataAsOf` (its offsets' age), never refused for
# its depth. A walk that runs out of its request deadline keeps its rungs and ONE background walk
# at a time across all processes (Redis lease tw:lease:v1:<ns>:deep-walk) carries on to the page.
LEADERBOARD_LADDER_MAX_AGE_MS=600000
# READ_PATH_REDIS_ENABLED=                 # unset = on in production only (tw:rb:v1:*, tw:lad:v1:*, every key with a TTL)
MONGO_REPLICATION_LAG_ALERT_MS=10000       # [alert] mongo.replication_lag past this (from the driver's own heartbeats)

# ─── Keyless /api per-address budget (src/common/api-limit.service.ts) — Step 1 of the /api anti-scraping plan; every env default = today (the 25-row /api page cap and the chart positionId check are always on) ───
# The website's own data API (/api/top-*) is keyless and protected only by an Origin check a script can forge. This budget
# prices every request by what it costs the database and the indexer and gives each client address a budget a real visitor
# stays far under. OFF until you turn it on: observe first (counters and logs only, never a 429), size the limits from its
# hour lines, then enforce. Rollback = set API_LIMIT_MODE=off (no redeploy of code, one env change).
# PREREQUISITE for enforce: TRUST_PROXY_HOPS must be right (Railway: 1), or every visitor shares ONE bucket. In production
# enforce is NOT applied while TRUST_PROXY_HOPS is 0 (it runs as observe and logs [alert] api_limit.trust_proxy).
API_LIMIT_MODE=off                         # off | observe | enforce
API_LIMITER_STORE=memory                   # memory | redis — several replicas on memory = N× the limit; use redis then (rl:v1:<ns>:api-limit:*, fails open to per-process)
API_LIMIT_POINTS_10S=100                   # PLACEHOLDER: points per 10 s per address (list 1, deep page 5, count 2, detail 2, search 3, chart 5; a cache miss costs +2 / +3 up front, refunded on a cache answer)
API_LIMIT_POINTS_HOUR=10000                # PLACEHOLDER: points per hour per address. Final values = 5–10× the heaviest real visitor from the observe hour lines
API_LIMIT_MAX_IN_FLIGHT=24                 # requests one address may have running at once, per process (carrier NAT: keep it loose)
API_LIMIT_COUNT_MISS_PER_MIN=3             # /count requests per address per minute that may miss the count cache (a miss can read ~100k documents)
API_READ_SHARE=1                           # (0, 1): the share of the global Mongo read budget keyless /api reads may take (0.5 = half); 1 / unset = no bound
# GET /diag/client-ip: echoes the caller's OWN address headers so TRUST_PROXY_HOPS can be set from a measurement. Off (404) unless on; switch on for the check only.
CLIENT_IP_ECHO=off                         # off | on
# Envio gateway: observe = meter only; enforce = budget, priority lanes, Retry-After pauses.
INDEXER_GATEWAY_MODE=observe
INDEXER_BUDGET_PER_MIN=900
INDEXER_BACKGROUND_MAX_PER_MIN=600         # >= 300/min always left for user requests
# In-flight caps per process. P2.1: UNSET = the PROCESS_ROLE default — in-flight all 12 (today),
# api 3, sync 6, fee/feeder 2 (api ×2 + sync = today's 12; with api ×3 set api to 2 explicitly);
# the interactive reserve all 4 (today), api 1, every role without http-api 0 — such a role
# IGNORES any reserve (all its slots are background slots: all 8, api 2, sync 6, fee 2, feeder 2).
# Setting either pins it for every role that reads this file; leave both unset on split services.
# INDEXER_MAX_IN_FLIGHT=
# INDEXER_INTERACTIVE_RESERVED_IN_FLIGHT=
INDEXER_INTERACTIVE_DEADLINE_MS=8000       # /api and /v1 indexer calls give up after this
INDEXER_BACKGROUND_TIMEOUT_MS=30000        # enforce mode only

# ─── P2.1 process roles + leases (src/common/process-role.ts) — every default = today ──
# ONE image, ONE DI graph; every side effect is gated by can(capability) at its start hook.
# Railway layout (the internal design notes): api ×2 (PROCESS_ROLE=api), sync-worker (sync),
# fee-worker (fee), feeder (only with P-R on). Same image, same env, only the role differs.
PROCESS_ROLE=all                           # all (today) | api | sync | fee | feeder
PROCESS_LEASES=auto                        # auto = off in `all`, on in a split role | on (leases/flow locks/global concurrency in one process too) | off (+ a split role refuses to boot: process_role.no_leases)
# PROCESS_STATUS_PUBLISH_MS=               # unset = 10000 whenever leases are on (role all included), 0 (no fan-in) in all + leases off; tw:proc:v1:<ns>:… status records
POSITIONS_REFRESH_QUEUE_CONCURRENCY=1      # > 1 only with WRITE_BUDGET_MODE=enforce (clamped to 1 otherwise, with a warning); max 64
BACKFILL_HELD_MAX_WAIT_MS=2700000          # a backfill job whose flow lock another process holds re-delays (60 s ± 10 s) for up to this long, then completes with [alert] sync.backfill_held_timeout

# ─── P2.2 shared state in Redis (src/common/{limiter-factory,invalidation-bus,redis-gcra,rpc-budget}.ts) — every default = today ──
AUTH_LIMITER_STORE=memory                  # memory | redis: auth brute-force limiters fleet-wide (rl:v1:<ns>:…); Redis down → per-process insurance ([alert] auth_limiter.insurance)
CACHE_INVALIDATION=off                     # off | redis: API-key / origin / settings / plan cache invalidation across replicas (tw:inv:v1:<ns>); the TTLs stay the backstop
INDEXER_BUDGET_SCOPE=process               # process | shared: ONE Envio token budget for the fleet (INDEXER_GATEWAY_MODE=enforce only), keyed by indexer URL; a 429 pause is shared
# INDEXER_BUDGET_LOCAL_SHARE=              # (0, 1]; unset = role default (all 1.0, api 0.25, sync 0.5, fee/feeder 0.25): the share of the budget a process takes alone while Redis is down
RPC_BUDGET_PER_SEC=0                       # 0 = off (today); the backend's share of the Dwellir ACCOUNT's req/s (prod 300, D-4). Every viem attempt (retries included) takes a token; a JSON-RPC batch one per member. Redis down: 100% of this in role all, 25% per process in a split role
RPC_ACCOUNT_MAP=                           # host=account,… — every host not listed = account `default` (all chains on one Dwellir account share ONE bucket)
RPC_MONTHLY_CAP=150000000                  # the backend's monthly request share; [alert] rpc.month_50 / _75 / _90

# ─── P2.3 skip unchanged position writes (src/database/position-write-hash.ts) — ON by default since 2026-10-07 ──
# on (default: unchanged rows not rewritten, changed sections written as leaves; the API overlays
# age / lastSyncedAt / pricedAt at read time) | shadow (decide + count, write every row + wh/wAt) |
# off (every row written on every refresh: the rollback, instant). The three defaults belong together:
# `on` alone skips only the rows that hold no value.
# The SAME value on every service (the api's read overlay must match the sync worker's writer).
# shadow / on also stamp sync_cursors.lastCleanRefreshAt per clean refresh (the overlay's input); off writes nothing new.
POSITIONS_WRITE_SKIP=on
POSITIONS_WRITE_SKIP_AGE=bucket            # bucket (default; D-1: APR ≤1% / ≤6 h behind) | refresh (the exact age: every valued row changes every cycle)
POSITIONS_WRITE_SKIP_TOLERANCE=exact       # exact | material (D-2, not recommended)
POSITIONS_GAS_REVALUE=full-write           # full-write (default; D-1b: gas USD re-valued only on full writes: every 6 h ±25%, 24 h ±25% for a $0 row) | always (on every write)
POSITIONS_FORCED_REWRITE_MS=21600000       # a full write at least this often, ±25% per position (below 60000 reads as the default)
POSITIONS_FORCED_REWRITE_ZERO_MS=86400000  # the same for rows whose stored and new value are both $0

# ─── P2.4 ONE shared write budget (src/common/write-budget*.ts) — the SAME value on every service ──
WRITE_BUDGET_MODE=off                      # off (today: nothing acquired, measured or sent to Redis) | observe (take + report the would-wait, never wait) | enforce (budgeted writes wait)
#                                          # observe / enforce also turn on [alert] positions.refresh_overdue (no successful refresh in 2 × POSITIONS_SYNC_INTERVAL_MS; sync_cursors.lastRefreshOkAt)
WRITE_BUDGET_UNITS_PER_SEC=300             # the controller's start R, u/s (1 u ≈ one full position update)
WRITE_BUDGET_MIN=100                       # AIMD floor, and R for everyone while no wb-controller holder writes one
WRITE_BUDGET_MAX=450                       # AIMD ceiling (700 only after R5)
# WRITE_BUDGET_HOURLY_UNITS_PER_SEC=       # unset = 0.5 × MAX; higher needs MONGO_MONITOR_URI, else clamped (D-6)
WRITE_BUDGET_SHARES=live:10,fee:25,refresh:30,backfill:25,pools:5,other:5  # guaranteed minimum shares; an idle lane's capacity repays the busy lanes' debt (borrowing)
WRITE_BUDGET_READ_UNIT=0.15                # units per primary document read to decide a write
WRITE_BUDGET_UNIT_LATENCY_RED_MS=2         # red: p95 ms per unit of ≤500 and >500-op chunks
WRITE_BUDGET_LATENCY_RED_MS=150            # red: p95 ms of ≤100-op chunks
WRITE_BUDGET_LAG_RED_MS=5000               # red: majority lag / worst secondary lag floor
WRITE_BUDGET_BACKFILL_MAX_NO_MONITOR=100   # backfill lane cap (u/s) while the oplog window is unobserved (no MONGO_MONITOR_URI); 0 = no cap
WRITE_BUDGET_LOCAL_DIVISOR=3               # Redis down → MIN / this per process
# MONGO_MONITOR_URI=                       # read-only clusterMonitor (+ read on `local`) user: dirty % and the oplog window
MONGO_BULK_WRITE_MAX_OPS=0                 # 0 = unbounded (today); 500 in rollout; never above 500 while the budget is on

# ─── Usage writes of metered /v1 calls (src/billing/usage-flush.service.ts, the internal design notes) — default = today ──
# direct (default) = today: 2 Mongo writes per metered request (the monthly usage snapshot + the usage_buckets row).
# batched = deltas HINCRBY'd into redis-state (REDIS_URL) and flushed by ONE process (lease usage-flush when
#   leases are on) as bulkWrite upserts every USAGE_FLUSH_INTERVAL_MS; portal / admin usage figures then trail
#   live traffic by up to one interval. Enforcement (rate-limiter-flexible) is unchanged.
# drain = producers write directly while the flusher empties the buffer — the ROLLBACK step:
#   batched → drain → (GET /admin/sync/status → usageWrites.drained === true) → direct. Never batched → direct.
# Set the SAME value on every api replica. Any other value refuses the boot.
USAGE_WRITE_MODE=direct
USAGE_FLUSH_INTERVAL_MS=10000              # flush period, ms (clamped 1000–300000; blank / ≤ 0 = 10000)

# ─── P2.5 / P3.1 backfill throughput (src/sync/backfill-profile.ts) — every default = today ──
BACKFILL_PAGING=offset                     # offset (today) | tokenid: range walk on the indexer's tokenId index + completeness tail; resumes / converts an interrupted offset run. Needs the indexer index @index(["chainId","tokenId"]) (EXPLAIN the two edge queries first)
BACKFILL_PIPELINE=off                      # on = run token cache, one pools request per range, prices never block normalize
BACKFILL_LOOKAHEAD_PAGES=0                 # 0–8 ranges prepared ahead (4 recommended with the pipeline)
BACKFILL_PRICE_WAIT_MS=5000                # pipeline: per-range price deadline, then cache-only + one last-known read
BACKFILL_FEE_READ=off                      # P3.1: the first on-chain fee reading inside the flush (the FeeMeasurer is bound; needs EVM_RPC_URLS; roles all/sync only)
PRICE_MISS_LEDGER=off                      # D-8: 30 min → 1 h → 2 h → 6 h ladder for tokens no aggregator prices (subgraph-current never gated)
GECKOTERMINAL_BUDGET=off                   # off (today) | local (a PER-PROCESS share of 30/min + lane caps) | shared (ONE fleet bucket on redis-state; Redis down → local share)
#                                          # PRICE_MISS_LEDGER=on or GECKOTERMINAL_BUDGET≠off also turn on the provider-health rules: GeckoTerminal's
#                                          # 429-as-HTTP-200 = rate limit (backoff, never a miss), an errored/refused/limited chunk is never "covered".
#                                          # Both off = today's reading (CHANGELOG owed the day either ships).
# GECKOTERMINAL_LOCAL_SHARE=               # (0, 1]; unset = role default (all 1.0, sync 0.5, others 0.25)

# ─── Read models on Railway (Phase P-R; src/read-models/) ─────────────
# EVERYTHING SHIPS OFF. `off` = today's behaviour exactly: no Redis connection, no key, no worker,
# no Mongo read. `shadow` = build and maintain the models (the feeder: change stream + paced scans
# on a secondary → redis-models snapshot + delta stream) while every response stays Mongo's, and
# lane A compares sampled answers with Mongo read at the same clusterTime; `serve` = answer from
# the models. Built: the POOL CATALOG (R2 — /api/top-pools, /v1/pools and their /count) and the
# POSITIONS RANK ENGINE (R3 — /api/top-positions, /v1/positions and their /count, every shape, deep
# pages, plus the pools routes' holder counts). Rollout: POOL_CATALOG_MODE=shadow → serve
# (READ_MODELS_SERVE_PERCENT 10 → 50 → 100), then RANK_ENGINE_MODE=shadow → serve the same way
# (design §7.3). Memory per process (measured, R3): today's sizes ≈ +1.0 GB off-heap with both models
# on (rank R1 0.20 + engine 0.23 GB, pools R1 0.33 + catalog 0.16 GB); full Robinhood ≈ +2.5 GB
# (rank alone ≈ 2.0 GB) — see the internal design notes. The runtime kill switch (POST /admin/read-models/override)
# can only LOWER these.
# R4 (verification + ops): lane B compares the holder's model ROWS with Mongo at one clusterTime
# (samples every minute + the paced verification scan below); GET /admin/sync/status → readModels
# carries `shadow.gate` / `shadow.fleet.gate` (the rollout gate: every lane-A bucket ≥ 50 checks,
# 0 diffs, lane B clean with a full pass per shard — summed across replicas and deploys for 4 days),
# `router` (degraded state per model, the fleet circuit, fallback reasons), `memoryGuard` and
# `ready`. A lane-A bucket too heavy to check (> 20k docs — every all-chains ranked bucket, the
# landing view included) is EXEMPT from the gate and needs the rig parity scripts instead; the gate
# counts the current CONTINUOUS shadow period only. Railway: point the healthcheck at
# GET /health/ready once a model is in `serve`, with a timeout LONGER than
# READ_MODELS_READY_TIMEOUT_MS + ~60 s (Railway counts from the container start, the env from the
# process start) and ≥ the snapshot load time — with every model off (or on a role that serves
# nothing) it always answers 200. Runbook: the internal design notes.
# Every numeric READ_MODELS_* below reads a BLANK value as unset (its default), never as 0.
READ_MODELS_MODE=off
# POOL_CATALOG_MODE=                       # per-model override of READ_MODELS_MODE (off|shadow|serve)
# RANK_ENGINE_MODE=                        # per-model override of READ_MODELS_MODE (off|shadow|serve)
READ_MODELS_SERVE_PERCENT=100              # in serve: share of eligible requests the model answers (ramp 10 → 50 → 100); a non-number reads as 0 (fail closed, [alert] read_models.config)
READ_MODELS_ROLE=auto                      # auto | both | feeder | server | none — auto follows PROCESS_ROLE: all → both, api → server, feeder → feeder, sync/fee → none
# The redis-models instance: noeviction, NO persistence, ~2 GB container / maxmemory 1536mb, private
# network. Unset = REDIS_URL (dev / rig). The feeder lease and the fence AUTHORITY stay on REDIS_URL
# (AOF everysec, noeviction). Append `?family=0` on Railway's private network if REDIS_URL needs it.
# REDIS_MODELS_URL=redis://default:password@redis-models.railway.internal:6379?family=0
# While a model cannot serve on a replica (not ready, kill switch, memory guard) its requests take
# today's Mongo path (p1). `narrow` (D-2, needs approval) would serve only cached / landing windows
# and indexed shapes while the FLEET circuit is open (≥ 50% of replicas not ready, or no holder
# append for > 60 s) — the decision is built, the list services do not implement it yet, so narrow
# currently behaves as p1 and the status says so.
READ_MODELS_DEGRADED_POLICY=p1
READ_MODELS_SHADOW_SAMPLE=0.05             # share of requests offered for a lane-A shadow check (shadow AND serve; pools since R2, positions + holder counts since R3)
READ_MODELS_SHADOW_MAX_PER_MIN=60          # hard cap on lane-A checks across processes (redis-state INCR per minute)
# Pace of cold scans / shard scans / field backfills on a secondary — a HARD ceiling of 5000
# (a larger value fails the boot). Its own bucket; it pauses while the user read budget waits or
# refuses (this process, or the shared tw:rb:v1 bucket below 10%).
READ_MODELS_SCAN_DOCS_PER_SEC=5000
# Lane B's verification scan (holder only): _id-keyset batches on a secondary at readConcern snapshot,
# compared row by row with the model; one full pass per shard takes rows ÷ this seconds (1.07M
# positions at 500/s ≈ 36 min). Paused / resumed / re-paced by POST /admin/read-models/scan with
# {"target":"verify"} (the default target "feeder" paces the feeder's own scans, never this one);
# yields to user-read pressure AND to a running feeder scan (one scan at a time on the secondary).
# 0 = off (the once-a-minute row samples still run). Same 5000 ceiling.
READ_MODELS_VERIFY_DOCS_PER_SEC=500
READ_MODELS_GENERATION_MS=2000             # engine generation period: the pool catalog (R2) and the rank engine (R3) apply the rows changed since the last one
READ_MODELS_SNAPSHOT_INTERVAL_MS=300000    # full snapshot cadence (30 s – 1 h); stream retention = 2 × this, never past the live manifest
# Abort a snapshot encode past this many ms (5 s – 5 min; blank = 20 s, the former hard-coded cap; never applied
# past half the 10-min chunk TTL used while a snapshot is written). Measured ~17 s at 6.5M rows and ~23 s at 8.8M:
# raise it above ~7.5M total rows, or every snapshot aborts and a cold start never becomes READY.
# [alert] read_models.snapshot_encode_slow (a committed encode over 75% of the cap) says what to set.
READ_MODELS_SNAPSHOT_ENCODE_TIMEOUT_MS=20000
READ_MODELS_MAX_LAG_MS=120000              # model data older than this is NOT READY (≥ the staleness budget; between: flagged stale)
READ_MODELS_READY_TIMEOUT_MS=300000        # /health/ready reports ready this long after the process started even if a serving model is not (R4); keep Railway's healthcheck timeout above it + ~60 s
READ_MODELS_WORKERS=2                      # pass workers per process, SHARED by the pool catalog and the rank engine (builds, generations, passes, search); 0 = everything in-thread (the feeder too — specs, debugging)
# Memory guard (R4): RSS against the container (process.constrainedMemory()) — 80% / 85% alert and
# drop the engines' answer caches (85%: also compiled plans), 90% unload the rank model, 95% the pool
# catalog too, on THIS replica — and the off-heap bytes against this cap (rank unloads first). On the
# lease holder only the ENGINE unloads (its rows keep feeding every replica). A shed model reloads
# after 5 / 10 / 20 min under 70%; its 4th shed in 6 h LATCHES it unloaded until the process
# restarts. 0 = container − V8 heap cap − 25%; with no container limit (dev) and 0 the guard is off.
# Measured on the M10 rig: ~450 B/row off-heap + ~1 GB fixed (3.5M rows → RSS 3.2 GB), ~4–5 GB at full
# Robinhood — on a 24 GB Railway replica set it explicitly (e.g. 8000) rather than deriving it.
READ_MODELS_MAX_MB=0
# Rows reserved per POSITIONS table at load (audit C-cap). 0 / unset = none (1.5 × loaded; tables grow by doubling).
# A plain number reserves it on EVERY positions table: ~137 B/row in the R1 table plus ~170 B/row in the rank
# engine's copy on a replica that serves rank, all counted by the memory guard — 6000000 on 4 tables is ~7 GB,
# over 70% of an 8000 MB cap ([alert] read_models.capacity). Prefer the per-chain form: chainId:rows pairs,
# comma-separated; unlisted chains grow as with 0. Garbage (non-numeric, negative, unknown or repeated chain) fails the boot.
# Before the full Robinhood backfill: READ_MODELS_POSITIONS_CAPACITY=4663:6000000 (~1.8 GB on a serving replica)
READ_MODELS_POSITIONS_CAPACITY=0
# The EXPECTED oplog window (Atlas does not let the app read local.oplog.rs): the feeder's boot probe
# starts a change stream half of it back and REFUSES to run (fail closed, [alert] read_models.oplog_too_short)
# when that fails; [alert] read_models.resume_age at half of it. Prerequisite: a 6 GB oplog / ≥ 3 h.
# The local M10 rig (1 GB oplog, ~25 min under load) needs ~1200000.
READ_MODELS_OPLOG_WINDOW_HINT_MS=10800000
# Durable copy of every 6th snapshot set, read only when redis-models has no manifest. This build
# supports file://<dir> only (dev, the rig, a single-replica service with a volume); unset = off.
# READ_MODELS_DURABLE_SNAPSHOT_URL=file:///data/read-models

# ─── Reserved (not yet wired) ─────────────────────────
# ALCHEMY_API_KEY=
# MORALIS_API_KEY=
