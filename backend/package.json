{
  "name": "positions-backend",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Positions and pools backend for Tickwise",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "refresh-allowlist": "node scripts/refresh-token-allowlist.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.1.17",
    "@noble/curves": "^1.9.1",
    "bullmq": "^5.71.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.2",
    "dotenv": "^16.3.0",
    "graphql": "16.14.0",
    "graphql-request": "^6.1.0",
    "ioredis": "^5.3.0",
    "mongoose": "^9.3.3",
    "rate-limiter-flexible": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "undici": "^6.21.0",
    "viem": "^2.55.10",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/node": "^20.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "overrides": {
    "ioredis": "^5.3.0"
