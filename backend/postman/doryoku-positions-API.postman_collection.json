              "path": [
                "v1",
                "positions"
              ],
              "query": [
                {
                  "key": "owner",
                  "value": "0x0000000000000000000000000000000000000000",
                  "description": "Owner wallet (0x EVM address, case-insensitive). Replace with the address to look up."
                },
                {
                  "key": "protocol",
                  "value": "uniswap-v4",
                  "description": "uniswap-v3 | uniswap-v4. Default uniswap-v4."
                },
                {
                  "key": "status",
                  "value": "all",
                  "description": "all → include open AND closed positions."
                },
                {
                  "key": "minValueUsd",
                  "value": "0",
                  "description": "0 → include dust/small positions."
                },
                {
                  "key": "minPoolTvl",
                  "value": "0",
                  "description": "0 → don't drop positions in low-TVL pools."
                },
                {
                  "key": "includeRisky",
                  "value": "true",
                  "description": "true → include risky/low-trust positions."
                },
                {
                  "key": "sort",
                  "value": "underlying_value",
                  "description": "apr | fee_apr | roi | age | pnl | underlying_value | nft_id_asc | nft_id_desc."
                },
                {
                  "key": "chainId",
                  "value": "1",
                  "description": "Restrict to one chain. OMIT for all enabled chains (scatter-gather merge).",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "1-based page. Default 1."
                },
                {
                  "key": "limit",
                  "value": "100",
                  "description": "Page size, 1-100. Default 20."
                }
