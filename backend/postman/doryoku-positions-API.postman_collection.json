                  "disabled": true
                },
                {
                  "key": "minValueUsd",
                  "value": "0",
                  "description": "Min underlying value in USD. Default 0.",
                  "disabled": true
                },
                {
                  "key": "minPoolTvl",
                  "value": "1000",
                  "description": "Min pool TVL in USD. Default 1000.",
                  "disabled": true
                },
                {
                  "key": "includeRisky",
                  "value": "false",
                  "description": "Include risky/low-trust positions. Default false.",
                  "disabled": true
                },
                {
                  "key": "positionId",
                  "value": "",
                  "description": "Exact tokenId / positionId lookup.",
                  "disabled": true
                },
                {
                  "key": "poolId",
                  "value": "",
                  "description": "Filter to a pool address (lowercased).",
                  "disabled": true
