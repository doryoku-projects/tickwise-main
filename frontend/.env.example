# The backend's origin. 3010 is its PORT default (see backend/.env.example); this
# frontend itself runs on 3011.
NEXT_PUBLIC_POSITIONS_API_URL=http://localhost:3010

# OPTIONAL — leave blank. Wallet sign-in works fully without it.
#
# The wallet picker is Web3-Onboard (MIT), and every wallet it offers by default
# needs no account and no key: browser extensions (MetaMask, Rabby, Brave, the
# Coinbase and Ledger extensions, …) plus the Coinbase Wallet SDK.
#
# Setting this ADDS the WalletConnect module, the only one that needs a hosted
# account — a project id from https://cloud.walletconnect.com (Reown). That buys
# mobile wallets over QR / deep link, and Ledger, whose Web3-Onboard module is a
# WalletConnect v2 client and refuses to initialise without an id.
#
# Public by design: inlined into the client bundle at build time, not a secret,
# so changing it needs a rebuild rather than a restart.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# OPTIONAL — the address /contact offers as a mailto.
#
# Unset is a supported state, not a broken one: the page then says plainly that
# we have not published an address yet and points at the docs, status and
# portal instead. That is deliberate — a contact page with a dead form or an
# invented address is worse than one that admits the gap. There is no
# contact endpoint on the backend, so this is the whole feature.
#
# Public by design: inlined into the client bundle at build time, so changing
# it needs a rebuild rather than a restart.
NEXT_PUBLIC_CONTACT_EMAIL=noemail@example.com
